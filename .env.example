POSTGRES_DB=fusiondex_db
POSTGRES_USER=fusiondex_user
POSTGRES_PASSWORD=changeme

# ─── Host ports (préfixe 5 pour éviter les collisions avec les défauts) ───
FUSIONDEX_FRONTEND_PORT=53000
FUSIONDEX_BACKEND_PORT=58000
FUSIONDEX_SPRITES_PORT=58080
FUSIONDEX_DB_PORT=55432
# Doc MkDocs (profil optionnel `--profile docs`)
FUSIONDEX_DOCS_PORT=58100
# Ollama LLM local (profil optionnel `--profile ollama`)
FUSIONDEX_OLLAMA_PORT=58200

# ─── CORS (defense in depth — le proxy Next masque déjà le backend en prod) ───
CORS_ALLOWED_ORIGINS=http://localhost:53000,http://localhost:58000

# ─── Reverse proxy (sécurité rate limiter) ───────────────────────────────────
# Mettre à 1 si le backend est derrière un reverse proxy (Caddy, Nginx…)
# qui injecte X-Forwarded-For. En dev, laisser à 0 (connexion directe).
# TRUSTED_PROXY=0

# ─── Clé interne Next.js ↔ FastAPI ───────────────────────────────────────────
# Optionnelle en dev (laisser vide = pas d'enforcement).
# Obligatoire en prod (docker-compose.prod.yml échoue si absente).
# Générer : openssl rand -hex 32
# INTERNAL_API_KEY=

# ─── AI (optionnel — au moins un provider, sinon POST /ai/ask renvoie 503) ───
# Priorité : DeepSeek > OpenRouter > Ollama (premier trouvé gagne).
#
# Option 1 — DeepSeek (cloud, qualité maximale)
#   Obtenir une clé : https://platform.deepseek.com/
# DEEPSEEK_API_KEY=sk-...
#
# Option 2 — OpenRouter (cloud, tier gratuit disponible)
#   Obtenir une clé gratuite : https://openrouter.ai/
#   Modèle par défaut : deepseek/deepseek-chat-v3-0324:free (gratuit, rate-limité)
#   Autres modèles gratuits : google/gemma-3-27b-it:free, meta-llama/llama-4-scout:free
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=deepseek/deepseek-chat-v3-0324:free
#
# Option 3 — Ollama (local, autonome, sans clé)
#   1. docker compose --profile ollama up -d ollama
#   2. décommenter la ligne ci-dessous
#   3. docker compose restart backend
# OLLAMA_URL=http://ollama:11434
#
# Modèle Ollama (défaut: qwen2.5:3b ~2 GB poids, ~4 GB RAM total).
# Upgrades possibles : qwen2.5:7b (4.5 GB) si tu as un GPU 8 GB / Apple Silicon.
# OLLAMA_MODEL=qwen2.5:3b
#
# ⚠ Windows / WSL2 : Docker Desktop limite WSL2 à 2 GB par défaut sur
#   certaines configs, ce qui provoque des OOM silencieux avec Ollama.
#   Si le modèle se charge mais répond avec des timeouts, créer/éditer :
#     %UserProfile%\.wslconfig
#   avec le contenu suivant, puis relancer Docker Desktop :
#     [wsl2]
#     memory=6GB
